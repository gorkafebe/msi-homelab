# Template for .env (the real file is ignored by git).
# Create the real one with:   scripts/init-env.sh
# It copies this file, replaces every "change-me" with a random password,
# sets mode 600 and never prints a value. Run it again after pulling: it only
# ADDS keys that are missing and never changes existing ones.

# --- Compose -------------------------------------------------------------
# The project name is deliberately NOT set here: `make` requires it on the
# command line (make demo COMPOSE_PROJECT_NAME=homelab-dev) and refuses the
# names of real deployments. See the Makefile.
# Optional services, comma-separated: pvpc (Spanish electricity price fetcher,
# talks to a public API), apphealth (HTTP probe of a local web app).
# Empty = only the core monitoring services.
COMPOSE_PROFILES=

# --- Grafana -------------------------------------------------------------
# Admin password. Used ONLY the first time Grafana creates its database.
GRAFANA_ADMIN_PASSWORD=change-me

# --- Monitoring ----------------------------------------------------------
# Host folder for *.prom files written by your own tools (experiment marks,
# backup status). Relative paths are relative to stacks/monitoring/.
TEXTFILE_HOST_DIR=./textfile

# --- Garmin module (only read with stacks/garmin/compose.garmin.yaml) ------
# InfluxDB listens on 127.0.0.1 only. 8088 is its backup/restore RPC port,
# which must not be left on all interfaces either.
INFLUXDB_PORT=8086
INFLUXDB_RPC_PORT=8088
# Three accounts, created on the FIRST start of an empty database:
# admin (you), writer (the fetcher), reader (Grafana, read-only).
INFLUXDB_ADMIN_PASSWORD=change-me
INFLUXDB_WRITE_PASSWORD=change-me
INFLUXDB_READ_PASSWORD=change-me
# Time zone the fetcher uses to decide which "day" a sample belongs to
# (IANA name, for example UTC or Europe/Berlin).
GARMIN_USER_TIMEZONE=UTC
# There is deliberately NO Garmin e-mail or password here. The first login is
# done once, by hand, with `make garmin-login`; afterwards only the session
# tokens in the garmin-tokens volume are used. See docs/GARMIN.md.
